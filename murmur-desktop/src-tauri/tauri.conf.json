{
  "$schema": "https://raw.githubusercontent.com/nicecoder-dev/tauri-schema/main/tauri.conf.v2.json",
  "productName": "Murmur",
  "version": "0.1.0",
  "identifier": "com.murmur.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Murmur",
        "width": 480,
        "height": 720,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
